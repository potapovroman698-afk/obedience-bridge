# Safe defaults: bind to loopback unless deployment explicitly requires otherwise.
HOST=127.0.0.1
PORT=3000
ADAPTER=fake

# Obedience authorization: leave all blank to disable, or set all required values together.
# OBEDIENCE_EXTENSION_ID=
# OBEDIENCE_REDIRECT_URL=https://example.com/obedience/callback
# OBEDIENCE_CREDENTIAL_PATH=/persistent-private-data/obedience-credentials.json
# OBEDIENCE_EXTENSION_NAME=Obedience Bridge

# Obedience webhook verification: leave all blank to disable, or set all three together.
# Supply real values through the deployment platform's secret/configuration layer.
# Do not commit the extension id/secret or paste real credentials into this file.
# OBEDIENCE_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# OBEDIENCE_WEBHOOK_EXTENSION_ID=
# OBEDIENCE_WEBHOOK_SECRET=

# Optional bearer token protecting the bridge's read API.
# BRIDGE_ACCESS_TOKEN=
